# Copia este archivo a .env (en la raíz) y ajusta lo que necesites.
# Todo tiene valores por defecto para desarrollo local; sin .env también arranca.

# ── Base de datos ──────────────────────────────────────────────────────
# Conexión de dueño (migraciones, seed, jobs, LISTEN). Equivale al
# "service role": nunca sale del servidor.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/despacho
# Conexión con la que el API atiende usuarios. Rol sin BYPASSRLS.
APP_DATABASE_URL=postgres://app_user:app_user_dev@127.0.0.1:5433/despacho

# ── API ────────────────────────────────────────────────────────────────
API_PORT=4000
JWT_SECRET=                       # obligatorio en producción (cadena larga y aleatoria)
JWT_TTL=12h
CORS_ORIGINS=http://localhost:3000  # en producción: el dominio del panel
PARSE_RATE_PER_MINUTE=20

# Parser con Claude. Sin key, el API usa el parser por reglas.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Push de ofertas (FCM HTTP v1): ruta al JSON de la cuenta de servicio de
# Firebase, o el JSON en una línea. Vacío = sin push (WebSocket + polling).
FCM_SERVER_CREDENTIALS=

# ── Panel (Next.js) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_MAP_STYLE_URL=        # vacío = OpenFreeMap (gratis, sin token)

# ── App del conductor (Expo) ───────────────────────────────────────────
# Vacío en desarrollo: usa la IP de la máquina que sirve el bundle, puerto 4000.
EXPO_PUBLIC_API_URL=

# Los valores de caducidad/timeout viven en la tabla app_settings (editables
# por ciudad desde el API); estos son los valores del seed, como referencia.
ZONE_STALE_MINUTES=45
LIVE_STALE_SECONDS=120
LIVE_PING_SECONDS=10
OFFER_TIMEOUT_SECONDS=60
