# Copia este archivo a .env y completa los valores.

# Conexión de dueño (migraciones, seed, tareas de servidor). Equivale al
# "service role": nunca sale del servidor.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/despacho
# Conexión que usa el API para atender usuarios. Rol sin BYPASSRLS: aquí
# se aplica la RLS.
APP_DATABASE_URL=postgres://app_user:app_user_dev@127.0.0.1:5433/despacho

JWT_SECRET=                       # firma de sesiones del API
ANTHROPIC_API_KEY=                # solo servidor (parser)
ANTHROPIC_MODEL=                  # configurable, sin valor fijo en código
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_MAP_STYLE_URL=        # estilo MapLibre
EXPO_PUBLIC_API_URL=
FCM_SERVER_CREDENTIALS=           # para push
ZONE_STALE_MINUTES=45
LIVE_STALE_SECONDS=120
LIVE_PING_SECONDS=10
OFFER_TIMEOUT_SECONDS=60
