---
import { FAQ } from '../faq';
---

<section id="preguntas" class="scroll-mt-20 bg-neblina">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-24">
    <p class="text-sm font-bold uppercase tracking-wider text-trocha-700">Preguntas frecuentes</p>
    <h2 class="font-display mt-2 text-3xl font-bold leading-tight sm:text-4xl">Lo que más nos preguntan</h2>
    <div class="mt-10 divide-y divide-cafetal-900/10 rounded-3xl bg-white px-6 ring-1 ring-cafetal-900/10">
      {
        FAQ.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-lg font-semibold">
              <span class="font-display">{f.q}</span>
              <span class="mt-1 shrink-0 text-cafetal transition group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3 leading-relaxed text-piedra">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
