---
import { BRAND, wa } from '../site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="bg-cafetal-900 text-neblina/80">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo tone="light" class="text-lg" />
      <p class="mt-3 max-w-sm text-sm">Despacho local de domicilios, mandados y transporte en {BRAND.city} y Villamaría, {BRAND.region}.</p>
    </div>
    <nav aria-label="Pie de página">
      <p class="font-semibold text-neblina">Arriero</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="hover:text-white" href="#negocios">Para negocios</a></li>
        <li><a class="hover:text-white" href="#conductores">Para conductores</a></li>
        <li><a class="hover:text-white" href="#preguntas">Preguntas frecuentes</a></li>
        <li><a class="hover:text-white" href={`${BRAND.appUrl}/privacidad`} rel="noopener">Tratamiento de datos</a></li>
      </ul>
    </nav>
    <div>
      <p class="font-semibold text-neblina">Contacto</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="hover:text-white" href={wa('Hola Arriero')} rel="noopener">WhatsApp</a></li>
        <li><a class="hover:text-white" href={`mailto:${BRAND.email}`}>{BRAND.email}</a></li>
        <li><a class="hover:text-white" href={`${BRAND.appUrl}/conductor`} rel="noopener">Entrar como conductor</a></li>
      </ul>
    </div>
  </div>
  <p class="border-t border-white/10 px-4 py-5 text-center text-xs text-neblina/60">© {year} {BRAND.name} · Hecho en Manizales</p>
</footer>
