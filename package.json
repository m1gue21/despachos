{
  "name": "despacho-local",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @despacho/api --filter @despacho/panel dev",
    "dev:driver": "pnpm --filter @despacho/driver start",
    "simulate": "pnpm --filter @despacho/api simulate",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "pnpm --filter @despacho/db reset",
    "db:test": "pnpm --filter @despacho/db test",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "demo:tracking": "pnpm --filter @despacho/api demo:tracking"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
